{
  "manifest_version": 3,
  "name": "Vimeo Kolay Kopyalama",
  "version": "0.1.0",
  "description": "Vimeo klasörlerindeki video adlarını ve bağlantılarını tek tıkla kopyalar.",
  "permissions": ["clipboardWrite", "sidePanel", "storage"],
  "host_permissions": ["https://vimeo.com/*", "https://*.vimeo.com/*"],
  "action": {
    "default_title": "Vimeo videolarını kopyala"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://vimeo.com/*", "https://*.vimeo.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
